{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@vfs/shared-types": ["../../packages/shared-types/src"],
      "@vfs/utils": ["../../packages/utils/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/shared-types/src/**/*.ts",
    "../../packages/utils/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
